flowchart TD
    Visitor([访问公司福利系统]) --> Who{你是哪种角色?}

    Who -->|行政 / HR| LoginA[输入工号 登录]
    Who -->|公司员工| LoginE[手机打开 输入工号]
    Who -->|分仓负责人| LoginV[输入工号 登录]

    %% ========== 行政 ==========
    subgraph ADMIN["🏢 行政 / HR （在电脑上操作）"]
        direction TB
        LoginA --> A0["管理后台首页<br/>看本期活跃活动 · 待核销总数 · 库存预警"]

        A0 --> SP1[【第一步】准备基础数据]
        SP1 --> SP1a[维护公司有哪些楼宇 / 分仓点]
        SP1 --> SP1b["导入员工花名册<br/>支持单个录入 或 Excel 批量上传<br/>(冲突可选：严格 / 跳过重复 / 覆盖更新)"]
        SP1 --> SP1c[维护礼物库<br/>名称 · 图片 · 估值 · 过敏原标签]
        SP1 --> SP1d[给每个分仓设置初始库存]

        A0 --> SP2[【第二步】发起一次福利活动]
        SP2 --> SP2a["填写活动名称 · 起止时间<br/>支持节日联动 春节 / 端午 / 中秋"]
        SP2a --> SP2b["设置谁可以领<br/>按 部门 / 楼宇 / 性别 / 是否有娃 / 入职年限 自由组合"]
        SP2b --> SP2c["挑选本次礼物<br/>固定唯一 或 让员工 N 选 1"]
        SP2c --> SP2d[(草稿)]
        SP2d --> SP2e[一键发布]
        SP2e -->|到达开始时间| SP2f[活动进行中]
        SP2f -.系统自动.-> SP2g[向所有符合资格的员工<br/>发送 飞书 或 邮件 通知<br/>「你有一份福利」]

        A0 --> SP3[【第三步】活动期间运营]
        SP3 --> SP3a[实时看每个活动的领取进度条]
        SP3 --> SP3b[看分仓库存矩阵<br/>低于 5 件自动预警]
        SP3 --> SP3c["调整库存数量<br/>系统保证 不会低于 已预约 + 已发出"]
        SP3 -.系统自动.-> SP3d["活动结束前 24 小时<br/>再次提醒尚未领取的员工"]
        SP3 -.系统自动.-> SP3e["活动结束前 2 小时<br/>最后一次提醒"]

        A0 --> SP4[【第四步】活动结束]
        SP4 -->|"到达结束时间 或 手动关闭"| SP4a[活动结束]
        SP4a -.系统自动.-> SP4b["未领取的预约自动失效<br/>库存自动释放回去<br/>没行动的员工资格作废"]
    end

    %% ========== 员工 ==========
    subgraph EMP["👤 员工 （在手机上操作）"]
        direction TB
        LoginE --> E0[我的福利首页]
        E0 --> E0a[待领取 - 我有资格但还没动]
        E0 --> E0b[待核销 - 我已预约 等去拿]
        E0 --> E0c[本期已领 - 已到手]
        E0 --> E0d[历史记录]
        E0 --> E0e[消息中心 - 与飞书/邮件同步]

        E0a -->|点击某个活动卡| EC1[活动详情页]
        EC1 --> EC2{我在资格名单吗?}
        EC2 -->|不在| ECx["⛔ 不在本次福利名单<br/>结束"]
        EC2 -->|在| EC3{活动是哪种?}
        EC3 -->|固定一件礼物| EC4[直接展示这件礼物]
        EC3 -->|多选一| EC5["展示候选礼物<br/>带过敏原提示"]

        EC4 --> EC6["选择去哪个分仓取<br/>看每个分仓还剩多少件"]
        EC5 --> EC6
        EC6 --> EC7[确认预约]
        EC7 --> EC8["✅ 拿到 6 位领取码 + 二维码<br/>显示分仓地址 · 取件截止倒计时"]
        EC8 -.可选.-> EC9["反悔 → 取消预约<br/>名额还回去"]

        E0b -->|"取件当天"| EG1[到了分仓<br/>给负责人看码 或 让 TA 扫码]
        EG1 --> EG2[核销完成]
        EG2 --> E0c
    end

    %% ========== 分仓 ==========
    subgraph VER["✅ 分仓负责人 （在手机上操作）"]
        direction TB
        LoginV --> V0["核销工作台<br/>只能看到自己负责楼宇的"]
        V0 --> V0a[本楼宇待核销名单 · 近 50 条]
        V0 --> V0b["本楼宇实时库存<br/>每件礼物 还剩 / 被锁定 / 已发出"]

        V0a --> Vw[员工到了]
        Vw --> Vi{怎么核?}
        Vi -->|扫二维码| Vs[扫码]
        Vi -->|手动输入| Vc[输入员工出示的 6 位码]
        Vs --> Vk{系统校验}
        Vc --> Vk

        Vk -->|码无效| Vf1[❌ 提示 无效]
        Vk -->|已经核过了| Vf2["⚠️ 提示 已于 X 时核销<br/>防重复发放"]
        Vk -->|预约已取消/过期| Vf3[❌ 提示 该预约已失效]
        Vk -->|活动已结束| Vf4[❌ 提示 活动结束]
        Vk -->|不是本楼宇的礼物| Vf5["❌ 提示 该礼物属于 X 楼<br/>请员工去对应分仓"]
        Vk -->|✅ 通过| Vo["核销成功<br/>显示 员工 · 礼物 · 活动"]
    end

    %% ========== 跨角色协作（最重要） ==========
    SP2g -. "员工收到通知" .-> E0e
    SP3d -. "24h 提醒" .-> E0e
    SP3e -. "2h 最后提醒" .-> E0e
    EC7 -. "库存被锁定 行政可见" .-> SP3b
    EC9 -. "库存释放回来" .-> SP3b
    Vo -. "库存真扣减<br/>员工收到 已领取 通知" .-> SP3b
    Vo -. "员工状态变 本期已领" .-> E0c
    SP4b -. "过期失效 库存释放" .-> SP3b

    Logout([登出]) -.-> Visitor
    ADMIN -.-> Logout
    EMP -.-> Logout
    VER -.-> Logout

    classDef admin fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef emp fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef ver fill:#fef3c7,stroke:#d97706,color:#78350f
    class ADMIN admin
    class EMP emp
    class VER ver
